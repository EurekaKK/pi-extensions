{
	"name": "pi-extensions",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"workspaces": ["extensions/*", "packages/*"],
	"engines": {
		"node": ">=22.19.0"
	},
	"scripts": {
		"check": "npm run check --workspaces --if-present",
		"test": "npm test --workspaces --if-present && npm run test:install-script",
		"test:install-script": "node --test \"scripts/test/*.test.mjs\""
	}
}
