{
	"name": "tavily-web-search",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"license": "MIT",
	"engines": {
		"node": ">=22.19.0"
	},
	"keywords": [
		"pi-package"
	],
	"files": [
		"index.ts",
		"src/**/*.ts",
		"defaults/config.json",
		"README.md"
	],
	"scripts": {
		"check": "biome check . && tsc --noEmit",
		"test": "vitest run --exclude \"test/integration/**\"",
		"test:integration:tavily": "vitest run test/integration"
	},
	"pi": {
		"extensions": [
			"./index.ts"
		]
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*",
		"typebox": "*"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.4",
		"@types/node": "^22.20.1",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	}
}
