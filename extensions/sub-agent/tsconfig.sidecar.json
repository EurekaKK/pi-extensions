{
	"compilerOptions": {
		"target": "ES2023",
		"lib": ["ES2023"],
		"module": "NodeNext",
		"moduleResolution": "NodeNext",
		"strict": true,
		"noUncheckedIndexedAccess": true,
		"exactOptionalPropertyTypes": true,
		"verbatimModuleSyntax": true,
		"skipLibCheck": true,
		"rootDir": "sidecar",
		"outDir": "dist/sidecar",
		"declaration": false,
		"sourceMap": false,
		"types": ["node"]
	},
	"include": ["sidecar/**/*.ts"]
}
